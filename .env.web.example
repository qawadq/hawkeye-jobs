# Private single-user login. Use at least 12 characters for the password.
HAWKEYE_WEB_PASSWORD=replace-with-a-long-random-password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HAWKEYE_WEB_SESSION_SECRET=replace-with-at-least-32-random-characters

# Exact hostnames, comma-separated. For a named Cloudflare Tunnel, add your chosen domain.
# Local browser testing:
HAWKEYE_ALLOWED_HOSTS=localhost,127.0.0.1

# Keep true behind HTTPS. Set false only for local HTTP testing.
HAWKEYE_COOKIE_SECURE=true

# Optional: set only after creating a named Tunnel and routing a hostname to http://hawkeye:8000.
CLOUDFLARE_TUNNEL_TOKEN=
